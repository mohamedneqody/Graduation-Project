{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pharmacy Golden Cases",
  "type": "array",
  "minItems": 15,
  "maxItems": 15,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "topic",
      "queries",
      "reply",
      "is_medical",
      "keywords"
    ],
    "properties": {
      "topic": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]+$"
      },
      "queries": {
        "type": "array",
        "minItems": 6,
        "maxItems": 6,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "reply": {
        "type": "string",
        "minLength": 1
      },
      "is_medical": {
        "type": "boolean"
      },
      "keywords": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
