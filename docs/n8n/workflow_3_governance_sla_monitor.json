      "typeVersion": 4,
      "position": [
        420,
        300
      ],
      "id": "e3300003-a1c0-4000-8000-000000000002",
      "notesInFlow": true,
      "notes": "جلب التذكيرات المعلقة عبر نقطة الحوكمة الداخلية"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst breached = [];\nconst now = new Date().getTime();\n\nfor (const item of items) {\n  const data = item.json;\n  if (data.decision === 'human_review') {\n    const createdTime = data.created_at ? new Date(data.created_at).getTime() : now;\n    const hoursElapsed = Math.round((now - createdTime) / (1000 * 60 * 60));\n    \n    if (hoursElapsed >= 24) {\n      breached.push({\n        json: {\n          ...data,\n          hours_elapsed: hoursElapsed,\n          sla_breached: true\n        }\n      });\n    }\n  }\n}\n\nreturn breached;\n"
      },
      "name": "2. Filter SLA Breaches (>24h)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ],
      "id": "e3300003-a1c0-4000-8000-000000000003",
      "notesInFlow": true,
      "notes": "فلترة التذكيرات التي تجاوزت حد الـ 24 ساعة بدون مراجعة بشرية"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.sla_breached }}",
              "value2": true
            }
          ]
        }
      },
      "name": "3. Is Breached?",
