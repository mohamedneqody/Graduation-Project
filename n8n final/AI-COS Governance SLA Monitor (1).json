        "text": "={{ (() => {\n  const esc = v => String(v ?? 'غير متاح').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n  return '⏳ <b>تجاوز مدة انتظار المراجعة البشرية</b>\\nعدد التذكيرات: '+esc($json.overdue_count)+\n    '\\nحد الانتظار: '+esc($json.review_threshold_hours)+' ساعة'+\n    '\\nأقدم مدة انتظار: '+esc($json.oldest_age_hours)+' ساعة'+\n    '\\nيرجى فتح لوحة المراجعة البشرية للاعتماد أو الرفض. هذا تنبيه إداري ولا يعتمد أي تذكير تلقائيًا.';\n})() }}",
        "additionalFields": {
