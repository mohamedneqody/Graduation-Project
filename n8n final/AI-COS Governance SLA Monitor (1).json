        "options": {
          "timeout": 5000
        }
      },
      "notesInFlow": true,
      "notes": "فحص جاهزية الخادم الخلفي قبل الاستعلام لتفادي الإنذارات الكاذبة عندما يكون السيرفر المحلي مغلقاً"
    },
    {
      "id": "a1c05a1a-4000-4000-8000-000000000011",
      "name": "Is Backend Online?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -2464,
        144
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "sla-health-status",
              "leftValue": "={{ $json.status || \"\" }}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "sla-health-service",
              "leftValue": "={{ $json.service || \"\" }}",
              "rightValue": "aicos-pharmacy-backend",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/internal/governance/review-overdue?hours=24",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_SERVICE_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "name": "1. Pull Pending Reminders",
      "type": "n8n-nodes-base.httpRequest",
