    },
    {
      "id": "a1c05a1a-4000-4000-8000-000000000012",
      "name": "Skipped - Backend Offline",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -2256,
        288
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "sla-skip-status",
              "name": "status",
              "value": "skipped",
              "type": "string"
            },
            {
              "id": "sla-skip-reason",
              "name": "reason",
              "value": "={{ $json.error?.message || $json.status || \"backend_offline\" }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nif (!Number.isInteger(data.overdue_count) || data.overdue_count < 0 ||\n    data.requires_human_approval !== true || !Number.isFinite(data.review_threshold_hours)) {\n  throw new Error('Invalid human-review SLA metrics');\n}\nreturn data.overdue_count > 0 ? [{json:{...data, sla_breached:true}}] : [];"
      },
      "name": "2. Filter SLA Breaches (>24h)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2048,
        64
      ],
      "id": "037e7196-f6c5-454c-b320-07b2836e7922",
      "notesInFlow": true,
      "notes": "فلترة التذكيرات التي تجاوزت حد الـ 24 ساعة بدون مراجعة بشرية"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.sla_breached }}",
              "value2": true
            }
          ]
        }
      },
      "name": "3. Is Breached?",
