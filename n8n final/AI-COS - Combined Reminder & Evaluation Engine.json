      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nif (!uuid.test(b.run_id || '') || !uuid.test(b.tenant_id || '') ||\n    !Number.isInteger(b.attempt) || b.attempt < 1) {\n  throw new Error('A persisted automation run, tenant and attempt are required');\n}\nreturn [{json:{run_id:b.run_id, tenant_id:b.tenant_id, attempt:b.attempt}}];"
