      "parameters": {
        "jsCode": "const rows = $input.all().flatMap(i => Array.isArray(i.json) ? i.json : [i.json]);\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst approved = rows.filter(r => r && uuid.test(r.reminder_id || '') && r.decision === 'approved' && r.status === 'pending');\nreturn approved.length ? approved.map(r => ({json:{reminder_id:r.reminder_id}})) : [{json:{skip:true}}];"
