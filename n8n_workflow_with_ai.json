\n            .content-padding { padding-left: 24px !important; padding-right: 24px !important; }\n            .mobile-full-width { display: block !important; width: 100% !important; }\n        }\n    </style>\n</head>\n<body width=\"100%\" style=\"margin: 0; padding: 0 !important; mso-line-height-rule: exactly; background-color: #F8FAFC;\">\n    <center style=\"width: 100%; background-color: #F8FAFC; text-align: center;\">\n        \n        <div style=\"display: none; font-size: 1px; line-height: 1px; max-height: 0px; max-width: 0px; opacity: 0; overflow: hidden; mso-hide: all; font-family: sans-serif;\">\n            تذكير طبي هام بخصوص استكمال خطتك العلاجية.\n        </div>\n\n        <!--[if mso | IE]>\n        <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color: #F8FAFC;\">\n        <tr><td align=\"center\" valign=\"top\" style=\"padding-top: 40px; padding-bottom: 40px;\">\n        <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\">\n        <tr><td align=\"center\" valign=\"top\">\n        <![endif]-->\n\n        <table role=\"presentation\" class=\"email-container\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" style=\"margin: 40px auto; background-color: #FFFFFF; border-radius: 20px; border: 1px solid #E2E8F0; width: 600px; max-width: 600px; overflow: hidden; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);\" dir=\"rtl\">\n            \n            <!-- Text Logo -->\n            <tr>\n                <td align=\"center\" class=\"content-padding\" style=\"padding: 40px 48px 0 48px;\">\n                    <p class=\"font-sans\" style=\"margin: 0; font-size: 22px; font-weight: 800; color: #0F766E; letter-spacing: -0.5px;\">\n                        🏥 صيدلية AI-COS 🏥\n                    </p>\n                </td>\n            </tr>\n\n            <!-- Hero Section -->\n            <tr>\n                <td align=\"center\" class=\"content-padding\" style=\"padding: 32px 48px 32px 48px;\">\n                    <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom: 20px;\">\n                        <tr>\n                            <td align=\"center\" style=\"background-color: #F0FDF4; border: 1px solid #BBF7D0; border-radius: 100px; padding: 6px 16px;\">\n                                <span class=\"font-sans\" style=\"font-size: 13px; font-weight: 700; color: #16A34A; letter-spacing: 0.5px;\">💚 تذكير بإعادة الطلب</span>\n                            </td>\n                        </tr>\n                    </table>\n                    \n                    <h1 class=\"font-sans\" style=\"margin: 0 0 16px 0; font-size: 32px; font-weight: 800; color: #0F172A; line-height: 1.3; letter-spacing: -0.5px;\">\n                        حان وقت إعادة طلب علاجك\n                    </h1>\n                    \n                    <p class=\"font-sans\" style=\"margin: 0; font-size: 18px; font-weight: 700; color: #334155; line-height: 1.6;\">\n                        مرحباً أستاذ {{ $('1. Pull Pending Reminders').item.json.customer_name }} 👋<br>\n                        <span style=\"font-weight: 500; color: #64748B;\">نتمنى لك دوام الصحة.</span>\n                    </p>\n                </td>\n            </tr>\n\n            <!-- Message Text -->\n            <tr>\n                <td align=\"center\" class=\"content-padding\" style=\"padding: 0 48px 32px 48px;\">\n                    <p class=\"font-sans\" style=\"margin: 0; font-size: 16px; color: #475569; line-height: 1.7; font-weight: 500;\">\n                        {{ $('2.5 Marketing Agent').item.json.message_text }}\n                    </p>\n                </td>\n            </tr>\n\n            <!-- Medicine Card -->\n            <tr>\n                <td align=\"center\" class=\"content-padding\" style=\"padding: 0 48px 32px 48px;\">\n                    <tabl