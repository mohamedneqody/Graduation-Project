                      <span style=\"font-family: 'Courier New', Courier, monospace; font-size: 42px; font-weight: 900; color: #1F2937; letter-spacing: 4px; line-height: 1;\">\n                                                {{ $('2.5 Marketing Agent').item.json.coupon_code }}\n                                            </span>\n                                        </td>\n                                    </tr>\n                                </table>\n                                \n                                <p class=\"font-sans\" style=\"margin: 24px 0 8px 0; font-size: 17px; color: #D97706; font-weight: 800;\">خصم 15% على إعادة طلب علاجك</p>\n                                <p class=\"font-sans\" style=\"margin: 0; font-size: 13px; color: #4B5563; font-weight: 600;\">📋 استخدم هذا الكود أثناء إتمام الطلب.</p>\n                            </td>\n                        </tr>\n                    </table>\n                </td>\n            </tr>\n\n            <!-- CTA Section -->\n            <tr>\n                <td align=\"center\" class=\"content-padding\" style=\"padding: 0 48px 16px 48px;\">\n                    <!--[if mso]>\n                    <v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\" href=\"https://dawaagate.com/reorder\" style=\"height:60px;v-text-anchor:middle;width:300px;\" arcsize=\"14%\" stroke=\"f\" fillcolor=\"#16A34A\">\n                        <w:anchorlock/>\n                        <center style=\"color:#ffffff;font-family:Arial,sans-serif;font-size:18px;font-weight:bold;\">استكمال إعادة الطلب</center>\n                    </v:roundrect>\n                    <![endif]-->\n                    <!--[if !mso]><!-->\n                    <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n                        <tr>\n                            <td align=\"center\" style=\"background-color: #16A34A; border-radius: 12px; box-shadow: 0 4px 12px rgba(22, 163, 74, 0.25);\">\n                                <a href=\"https://dawaagate.com/reorder\" target=\"_blank\" class=\"font-sans\" style=\"display: inline-block; padding: 18px 48px; font-size: 18px; font-weight: 800; color: #FFFFFF; text-decoration: none; border-radius: 12px;\">استكمال إعادة الطلب</a>\n                            </td>\n                        </tr>\n                    </table>\n                    <!--<![endif]-->\n                </td>\n            </tr>\n\n            <!-- Microcopy -->\n            <tr>\n                <td align=\"center\" class=\"content-padding\" style=\"padding: 0 48px 32px 48px;\">\n                    <p class=\"font-sans\" style=\"margin: 0; font-size: 13px; color: #94A3B8; font-weight: 500;\">\n                        لن تستغرق إعادة الطلب أكثر من دقيقة.\n                    </p>\n                </td>\n            </tr>\n\n            <!-- Trust Indicators -->\n            <tr>\n                <td align=\"center\" class=\"content-padding\" style=\"padding: 0 48px 40px 48px;\">\n                    <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" dir=\"rtl\">\n                        <tr>\n                            <td align=\"center\" valign=\"top\" width=\"33%\">\n                                <p style=\"margin: 0; font-size: 18px;\">🚚</p>\n                                <p class=\"font-sans\" style=\"margin: 6px 0 0 0; font-size: 14px; font-weight: 700; color: #334155;\">توصيل سريع</p>\n                            </td>\n                            <td align=\"center\" valign=\"top\" width=\"33%\">\n                                <p style=\"margin: 0; font-size: 18px;\">🔒</p>\n                                <p class=\"font-sans\" style=\"margin: 6px 0 0 0; font-size: 14px; font-weight: 700; color: #334155;\">دفع آمن</p>\n                            </td>\n                            <td align=\"center\" valign=\"top\" width=\"33%\">\n                                <p style=\"margin: 0; font-size: 18px;\">👨⚕️</p>\n                                <p class=\"font-sans\" style=\"margin: 6px 0 0 0; font-size: 14px; font-weight: 700; color: #334155;\">دعم صيدلي</p>\n                            </td>\n                        </tr>\n                    </table>\n                </td>\n            </tr>\n\n            <!-- Minimal Footer -->\n            <tr>\n                <td align=\"center\" class=\"content-padding\" style=\"padding: 32px 48px; background-color: #F8FAFC; border-top: 1px solid #F1F5F9; border-radius: 0 0 20px 20px;\">\n                    <p class=\"font-sans\" style=\"margin: 0; font-size: 13px; color: #64748B; font-weight: 600;\">\n                        شكراً لثقتكم برعايتنا الصحية. نحن هنا دائماً لخدمتكم.\n                    </p>\n                </td>\n            </tr>\n\n        </table>\n\n        <!--[if mso | IE]>\n        </td></tr></table>\n        </td></tr></table>\n        <![endif]-->\n        \n        <br><br>\n    </center>\n</body>\n</html>",
