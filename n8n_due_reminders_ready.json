{
  "name": "Due Reminders Workflow (Ready for Production)",
  "nodes": [
    {
      "parameters": {},
      "id": "b73523ba-171b-4fc3-a55e-04f8ab4f86d4",
      "name": "When clicking \"Execute Workflow\"",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        220,
        240
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/internal/cycles/due-reminders",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Service-Key",
              "value": "dev-secret-key"
            },
            {
              "name": "X-Internal-Token",
              "value": "=$N8N_SERVICE_KEY"
            }
          ]
        },
        "options": {},
        "queryParameters": {
          "parameters": [
            {
              "name": "tenant_id",
              "value": "={{ $json.tenant_id }}"
            }
          ]
        }
      },
      "id": "9ca1cd1d-6b54-4375-9c8e-a9bb2c1b5277",
      "name": "Fetch Due Reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        440,
        240
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e4f8d5b4-d55c-4395-8854-3e9a597a7a51",
              "name": "message",
              "value": "تذكير: الأدوية دي قربت تخلص: {{ $json.due_drugs }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "f5de8889-1304-44cd-9f7a-85b91b9efb8b",
      "name": "Set Reminder Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [
        660,
        240
      ]
    },
    {
      "parameters": {},
      "id": "22e6db1a-50db-44a6-ae45-b4618e478546",
      "name": "NoOp",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        880,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/internal/notifications/record",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"customer_id\": \"{{ $json.customer_id }}\",\n  \"notification_type\": \"reminder\",\n  \"channel\": \"whatsapp\",\n  \"status\": \"sent\"\n}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Service-Key",
              "value": "dev-secret-key"
            },
            {
              "name": "X-Internal-Token",
              "value": "=$N8N_SERVICE_KEY"
            }
          ]
        },
        "options": {}
      },
      "id": "f90df23a-ec92-494b-9727-4a0b5a1db4b2",
      "name": "Record Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1100,
        240
      ]
    }
  ],
  "connections": {
    "When clicking \"Execute Workflow\"": {
      "main": [
        [
          {
            "node": "Fetch Due Reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Due Reminders": {
      "main": [
        [
          {
            "node": "Set Reminder Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Reminder Message": {
      "main": [
        [
          {
            "node": "NoOp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "NoOp": {
      "main": [
        [
          {
            "node": "Record Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}